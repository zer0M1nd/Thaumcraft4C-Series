            "with": [
              [
                {
                  "text": "推荐顺序\n",
                  "bold": true
                }
              ]
            ]
          }
        },
        {
          "id": "thaumicbases:tut_addon_thaumicbases/text/5",
          "type": "TEXT",
          "text": {
            "translate": "tc.tutorial.thaumicbases.tut_addon_thaumicbases.text.5",
            "with": [
              [
                {
                  "text": "· "
                },
                {
                  "research": "TB.DecoBlocks"
                },
                {
                  "text": "：装饰方块，自动解锁。\n· "
                },
                {
                  "research": "TB.BasicPlants"
                },
                {
                  "text": "：神秘自然，魔法作物与树苗。\n· "
                },
                {
                  "research": "TB.Thauminite"
                },
                {
                  "text": "：秘晶锭，介于神秘锭和虚空金属之间的材料。\n· "
                },
                {
                  "research": "TB.AdvAlc"
                },
                {
                  "text": "：高级炼金炉，更快的源质蒸馏。\n· "
                },
                {
                  "research": "TB.Bracelet.Iron"
                },
                {
                  "text": "：奥术手镯，一种不同于法杖的施法道具。\n· "
                },
                {
                  "research": "TB.NodeMan"
                },
                {
                  "text": "：节点调节器。\n"
                }
              ]
            ]
          }
        },
