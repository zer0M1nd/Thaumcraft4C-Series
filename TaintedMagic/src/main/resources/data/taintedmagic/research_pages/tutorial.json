                {
                  "research": "taintedmagic:SHADOWMETAL"
                },
                {
                  "text": "：暗影锭。\n· "
                },
                {
                  "research": "taintedmagic:CRIMSONROBES"
                },
                {
                  "text": "：血腥工艺。\n· "
                },
                {
                  "research": "taintedmagic:ROD_warpwood"
                },
                {
                  "text": "：扭曲之木杖柄。\n· "
